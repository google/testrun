{% macro insert(json_data, device, modules, duration) %}
<div class="summary-content">
  <div class="device-information">
    <div style="padding-right:0.1in;">
      <div class="summary-item-label"><h4>Manufacturer</h4></div>
      <div class="summary-item-value">{{ device['manufacturer']}}</div>
      <div class="summary-item-space"></div>
      <div class="summary-item-label"><h4>Model</h4></div>
      <div class="summary-item-value">{{ device['model'] }}</div>
      <div class="summary-item-space"></div>
      <div class="summary-item-label"><h4>Firmware</h4></div>
      <div class="summary-item-value">{{ device['firmware']}}</div>
      <div class="summary-item-space"></div>
      <div class="summary-item-label"><h4>MAC Address</h4></div>
      <div class="summary-item-value">{{ device['mac_addr'] }}</div>
      {% if device['kernel'] %}
        <div class="summary-item-space"></div>
        <div class="summary-item-label"><h4>Kernel</h4></div>
        <div class="summary-item-value">{{ device['kernel'] }}</div>
      {% endif %}
    </div>
  </div>
    <div class="summary-device-modules">
      <div class="summary-item-label" style="margin-bottom:10px;">
        <h4>Device Configuration</h4>
      </div>
      {% for module, enabled in modules.items() %}
      <div class="summary-device-module-label">
        {% if enabled %}
          <span style="color:#34a853">✔ </span>
        {% else %}
          <span style="color:#ea4335">✖ </span>
        {% endif %}
        {{ module }}
      </div>
      {% endfor %}
    </div>
    {% if json_data['result'] == 'Compliant' %}
      <div class ="summary-color-box summary-box-compliant">
    {% else %}
      <div class ="summary-color-box summary-box-non-compliant">
    {% endif %}
      <div class="summary-box-label">Test Status</div>
      <div class="summary-box-value">{{ json_data['status'] }}</div>
      <div class="summary-box-label">Test Result</div>
      <div style="color: white; font-size:24px; font-weight: 700;" class="summary-box-value">{{ json_data['result'] }}</div>
      <div class="summary-box-label">Started</div>
      <div class="summary-box-value">{{ json_data['started']}}</div>
      <div class="summary-box-label">Duration</div>
      <div class="summary-box-value">
        {% if duration.seconds//3600 > 0 %}{{ duration.seconds//3600 }}h {% endif %}
        {% if (duration.seconds % 3600) // 60 > 0 %}{{ (duration.seconds % 3600) // 60 }}m {% endif %}
        {{ duration.seconds%60 }}s
      </div>
  </div>
</div>
{% endmacro %}

<style>
  /* Import Google Sans for accurate typography */
  @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@500&display=swap');
  
  /* Fallback to system fonts if Google Sans isn't available */
  :root {
    --font-family-title: 'Google Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    --font-family-text: 'Google Sans Text', 'Google Sans Flex', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .environment-details-card {
    /* Auto layout */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 20px 20px 20px 24px;
    gap: 16px;
    
    /* Dimensions & Styling */
    width: 1110px;
    box-sizing: border-box;
    background: #F0F4F8;
    border-radius: 12px;
  }

  .env-title {
    font-family: var(--font-family-title);
    font-style: normal;
    font-weight: 500;
    font-size: 22px;
    line-height: 28px;
    color: #202124;
    margin: 0;
  }

  .env-data-container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0px;
    gap: 16px;
    width: 100%;
  }

  .env-data-row {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding: 0px;
    gap: 16px;
    width: 100%;
  }

  .env-data-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0px;
    gap: 4px;
    flex: 1; /* Равномерно распределяет все элементы в ряду */
  }

  .env-label {
    font-family: var(--font-family-text);
    font-style: normal;
    font-weight: 500;
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.1px;
    color: #5F6368;
  }

  .env-value {
    font-family: var(--font-family-text);
    font-style: normal;
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    color: #202124;
  }
</style>
</head>
<body>

<div class="environment-details-card">
  <h2 class="env-title">Environment Details</h2>
  
  <div class="env-data-container">
    <!-- Единственный ряд со всеми данными -->
    <div class="env-data-row">
      <div class="env-data-item">
        <span class="env-label">Location ID</span>
        <span class="env-value">LOC-2847-US-WEST</span>
      </div>
      <div class="env-data-item">
        <span class="env-label">Timestamp</span>
        <span class="env-value">2023-06-22T16:12:34.567Z</span>
      </div>
      <div class="env-data-item">
        <span class="env-label">Linux Environment Details</span>
        <span class="env-value">Ubuntu 22.04.2 LTS (Jammy Jellyfish) x86_64</span>
      </div>
      <div class="env-data-item">
        <span class="env-label">Linux Kernel Version</span>
        <span class="env-value">5.15.0-76-generic</span>
      </div>
      <div class="env-data-item">
        <span class="env-label">Device Hardware Version</span>
        <span class="env-value">Rev. 3.2.1 (PCB-A07)</span>
      </div>
    </div>
  </div>
</div>
